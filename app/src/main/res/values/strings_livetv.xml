<?xml version="1.0" encoding="utf-8"?>
<!--
    NuvioES: strings for the Live TV feature.

    This file is OURS. Android merges every .xml under res/values, so the feature
    keeps its strings here and never touches upstream's strings.xml. That is what
    keeps a Nuvio update free of translation conflicts: the reference fork added
    its strings inside upstream's files and now carries four conflicted locale
    files on every sync.
-->
<resources>
    <string name="nav_live_tv">Live TV</string>
    <string name="live_tv_empty_title">No channels yet</string>
    <string name="live_tv_empty_desc">Channels come from the addons you already have installed.</string>
    <string name="live_tv_empty_action">Manage addons</string>
    <string name="live_tv_loading">Looking for channels…</string>
    <string name="live_tv_error_title">Could not read your channels</string>
    <string name="live_tv_retry">Try again</string>
    <string name="live_tv_channels_count">%1$d channels</string>
    <string name="live_tv_no_guide">No guide data</string>
    <string name="live_tv_select_channel">Move around to see a channel\'s details</string>
    <string name="live_tv_resolving">Opening…</string>
    <string name="live_tv_up_next">Next: %1$s</string>
    <string name="live_tv_play_failed_no_streams">This channel has no available source</string>
    <string name="live_tv_play_failed_resolve">The addon could not be reached</string>
    <string name="live_tv_preview_loading">Loading preview…</string>
    <string name="live_tv_guide_failed">Guide: %1$s — %2$s</string>
    <string name="live_tv_guide_reason_download">could not be downloaded</string>
    <string name="live_tv_guide_reason_too_large">the file is too large</string>
    <string name="live_tv_guide_reason_malformed">the document is unreadable</string>
    <string name="live_tv_guide_reason_empty">no programming found</string>
    <string name="live_tv_guide_no_programmes">Guide: downloaded, but it carries no programming for these channels</string>
    <string name="live_tv_guide_programmes">%1$d programmes</string>
</resources>
